# Copy to .env and fill in. .env is git-ignored. Compose auto-loads it.
#
# This Compose stack is the DEV / single-host environment (production runs on k8s — see k8s/).
# Every dev toggle has a safe default baked into docker-compose.yml, so a minimal .env only needs
# the REQUIRED secrets below. The "Dev toggles" block documents the rest — override there only to
# change a default or to harden the stack when running somewhere exposed.

# --- LLM / agent credentials (REQUIRED) ---
ANTHROPIC_API_KEY=
# Optional: custom Anthropic-compatible gateway (leave blank for the public API).
ANTHROPIC_BASE_URL=
# Optional: Groq (used by some agent nodes).
GROQ_API_KEY=

# --- LangGraph Server (licensed langchain/langgraph-api image) ---
# Self-hosted LangGraph Server needs a license. Provide EITHER an enterprise license key OR a
# LangSmith API key on a plan that entitles self-hosting. At least one is required for `agent`.
LANGGRAPH_CLOUD_LICENSE_KEY=
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=book-recommendation-v1

# --- Service-to-service secret (accounts internal face; agent presents it as X-Service-Token) ---
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
ACCOUNTS_SERVICE_TOKEN=dev-internal-service-token

# --- Postgres (bundled) ---
POSTGRES_USER=book
POSTGRES_PASSWORD=book
POSTGRES_DB=book

# --- Public entry point ---
# Host port the UI (nginx) is published on.
UI_PORT=8080

# --- Dev toggles (defaults live in docker-compose.yml; set here only to override) ---
# Browser origins allowed to call accounts/service cross-origin. 8080 = compose UI; 5173 = `npm run dev`.
CORS_ORIGINS=http://localhost:8080,http://localhost:5173
# Refresh cookie Secure flag. false over plain http (dev); set true once TLS terminates in front.
REFRESH_COOKIE_SECURE=false
# Service auth. 0 = enforce real JWT (dev default, accounts issues tokens locally); 1 = bypass.
DEV_AUTH=0
# Host interface the debug ports (agent :2024, postgres :5432) bind to. 0.0.0.0 = reachable on the
# network (dev). Set 127.0.0.1 to restrict them to this machine when running somewhere exposed.
DEBUG_BIND=0.0.0.0
